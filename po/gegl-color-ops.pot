#: ops/gray-to-component/gray-to-component.c:84
#: ops/max-min/max-min.c:48
#: plugin/max-min/max-min.py:226
msgid "Mode"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:85
msgid "Encoding mode: which component the grey level maps to. Use hue/saturation/color/value with the HSV and HSL group blend modes, lightness/luminance/lch-* with the LCh group and Luminance, and Lighten to stack the three RGB channels back into colour."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:92
msgid "Input Space"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:94
msgid "Domain the input pixel values live in. Pick encoded if the component layer came from an 8/16-bit image (the filter stack buffers as R'G'B'A float), linear if it came from a 32-bit float linear image (RGBA float). Choosing wrong makes babl apply the gamma encoding a second time, so the encoded values come out too bright."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:96
msgid "Saturation Hue"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:97
msgid "Hue (degrees) used by Saturation mode; 0 = red, change it as needed. The layer only carries saturation, so the hue never enters the composite."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:100
msgid "Color Saturation"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:101
msgid "Fixed saturation percentage for Color mode. Color blend reads both hue and saturation, but a single grey channel can only carry one of them: the grey carries hue and this parameter supplies saturation. At 100% the output matches hue mode."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:104
msgid "LCh Lightness"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:105
msgid "Fixed lightness L (0-100) used by the LCh modes. When the blend mode only reads hue or chroma this value has no effect; it sits in the middle so the colour stays inside the common gamut."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:108
#: ops/gray-to-component/gray-to-component.c:77
msgid "LCh Chroma"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:109
msgid "Fixed chroma C used by lch-hue and lch-color (both encode identically). Higher chroma means more vivid colour; too high can leave sRGB (it still round-trips in float32)."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:113
msgid "LCh Hue Angle"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:114
msgid "Fixed hue (degrees) used by LCh Chroma mode; 0 = red. The layer only carries chroma, so the hue never enters the composite."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:117
msgid "Chroma Scale"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:118
msgid "Full scale for LCh Chroma mode: the chroma that grey 1.0 maps to. GIMP's component-extract normalises C to 200 (lch-c = C/200), so set 200 when feeding it decomposed output; keep 100 when building your own grey layer. Inside sRGB chroma tops out around 131; anything above still round-trips in float32."
msgstr ""

#: ops/gray-to-component/gray-to-component.c:441
#: ops/gray-to-component/gray-to-component.c:444
msgid "Gray To Component"
msgstr ""

#: ops/gray-to-component/gray-to-component.c:442
msgid "Re-encode a decomposed component gray layer into a color layer that GIMP's color-group blend modes read back exactly. Feed the result as a blend layer: Hue mode for 'hue', Saturation for 'saturation', Color for 'color', Value for 'value', LCh Lightness for 'lightness', Luminance for 'luminance', LCh Hue / LCh Color for 'lch-hue' / 'lch-color', LCh Chroma for 'lch-chroma', and Lighten to recombine the red/green/blue channel layers. Encoding formulas are calibrated by identity round-trip against GIMP 3 blend modes."
msgstr ""

