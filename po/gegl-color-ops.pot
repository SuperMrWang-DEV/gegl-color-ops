#: ops/dust-scratches/dust-scratches.c:36
msgid "Neighbourhood radius in pixels. 1 is a 3×3 window. Bigger values remove bigger specks and also soften more detail."
msgstr ""

#: ops/dust-scratches/dust-scratches.c:41
#: ops/unsharp-mask/unsharp-mask.c:51
#: plugin/sky-replace/sky-replace.py:220
msgid "Threshold"
msgstr ""

#: ops/dust-scratches/dust-scratches.c:42
msgid "Neighbours that differ from the centre pixel by more than this many levels (0–255) are ignored, which is what keeps real edges intact. Raise it to remove stronger dust, lower it to protect fine texture."
msgstr ""

#: ops/dust-scratches/dust-scratches.c:226
#: ops/dust-scratches/dust-scratches.c:233
msgid "Dust & Scratches"
msgstr ""

#: ops/dust-scratches/dust-scratches.c:227
msgid "Replaces a pixel with the median of the neighbours that are within the threshold, so isolated dust and scratches vanish while real edges — whose neighbours differ too much — stay untouched."
msgstr ""

