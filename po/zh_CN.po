#: plugin/dodge-burn/dodge-burn.py:183
#: plugin/dodge-burn/dodge-burn.py:243
msgid "Dodge & Burn"
msgstr "双曲线磨皮 (Dodge & Burn)"

#: plugin/dodge-burn/dodge-burn.py:189
msgid "1 · Dodge (black mask)"
msgstr "1 · 提亮（黑蒙版）"

#: plugin/dodge-burn/dodge-burn.py:189
msgid "1 · Dodge curve"
msgstr "1 · 提亮曲线"

#: plugin/dodge-burn/dodge-burn.py:189
msgid "Paint white to dodge"
msgstr "涂白提亮"

#: plugin/dodge-burn/dodge-burn.py:190
msgid "2 · Burn (black mask)"
msgstr "2 · 压暗（黑蒙版）"

#: plugin/dodge-burn/dodge-burn.py:190
msgid "2 · Burn curve"
msgstr "2 · 压暗曲线"

#: plugin/dodge-burn/dodge-burn.py:190
msgid "Paint white to burn"
msgstr "涂白压暗"

#: plugin/dodge-burn/dodge-burn.py:216
msgid "Dodge & Burn is set up: a dodge and a burn layer, each with its own curve and a fully black mask, so the image is currently identical to the original. Click one layer's mask and paint with a soft white brush (opacity 10–20%%): painting on the dodge layer lightens, on the burn layer darkens. Strength %g%% (lifts/lowers by %.2f at 0.5)."
msgstr "双曲线磨皮已建立：提亮、压暗两层各挂一条曲线，蒙版全黑，所以现在与原图完全一致。点中某层的蒙版，用白色柔边画笔（不透明度 10–20%%）涂抹：涂提亮层变亮，涂压暗层变暗。强度 %g%%（0.5 处抬/压 %.2f）。"

#: plugin/dodge-burn/dodge-burn.py:218
#: plugin/frequency-separation/frequency-separation.py:217
#: plugin/hsi-split-curves/hsi-split-curves.py:275
#: plugin/hsl-split-curves/hsl-split-curves.py:404
#: plugin/hsl-split-curves/hsl-split-curves.py:474
#: plugin/hsv-split-curves/hsv-split-curves.py:429
#: plugin/hsv-split-curves/hsv-split-curves.py:498
