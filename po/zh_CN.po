msgstr "LCh 分量曲线 · %s"
#: ops/apply-image/apply-image.c:72
#: ops/calculations/calculations.c:75
#: ops/displace/displace.c:52
#: ops/match-color/match-color.c:72
msgid "Luminance"
msgstr "亮度"

#: ops/apply-image/apply-image.c:73
#: ops/calculations/calculations.c:76
#: ops/displace/displace.c:56
#: plugin/blend/blend.py:594
msgid "Alpha"
msgstr "Alpha 通道"

#: ops/displace/displace.c:77
msgid "Horizontal amount"
msgstr "水平位移量"

#: ops/displace/displace.c:78
msgid "Displacement along X for a map value at the white point"
msgstr "位移图取白场值时的水平位移量"

#: ops/displace/displace.c:81
msgid "Vertical amount"
msgstr "垂直位移量"

#: ops/displace/displace.c:82
msgid "Displacement along Y for a map value at the white point"
msgstr "位移图取白场值时的垂直位移量"

#: ops/displace/displace.c:85
msgid "Amount unit"
msgstr "位移量单位"

#: ops/displace/displace.c:87
msgid "Pixels stay fixed when the image is resized; a percentage of the long edge scales with it"
msgstr "像素不随图像缩放；按长边百分比则跟着一起缩放"

#: ops/displace/displace.c:90
msgid "Map mode"
msgstr "位移图模式"

#: ops/displace/displace.c:92
msgid "Vector reads R as X and G as Y, so one RGBA map drives both axes. Single channel reads one channel and feeds it to both amounts, the classic grey-map setup"
msgstr "矢量：R 作水平、G 作垂直，一张 RGBA 图同时驱动两轴。单通道：一个通道同时喂两个位移量，对应传统灰度图用法"

#: ops/displace/displace.c:96
msgid "Map channel"
msgstr "位移图通道"

#: ops/displace/displace.c:98
msgid "Channel read in single channel mode"
msgstr "单通道模式下读取的通道"

#: ops/displace/displace.c:101
msgid "Black point"
msgstr "黑场"

#: ops/displace/displace.c:102
msgid "Map value that means the full negative displacement"
msgstr "位移图取这个值时是负向满量位移"

#: ops/displace/displace.c:105
msgid "Midpoint"
msgstr "中点"

#: ops/displace/displace.c:106
msgid "Map value that means no displacement. Grey maps use 0.5; vector fields that are zero at rest use 0"
msgstr "位移图取这个值时不动。灰度图用 0.5，零中性矢量场用 0"

#: ops/displace/displace.c:110
msgid "White point"
msgstr "白场"

#: ops/displace/displace.c:111
msgid "Map value that means the full positive displacement"
msgstr "位移图取这个值时是正向满量位移"

#: ops/displace/displace.c:114
msgid "Weight by map alpha"
msgstr "按位移图 alpha 加权"

#: ops/displace/displace.c:115
msgid "Multiply the displacement by the map's alpha. GEGL's own displace always does this, which silently cancels the displacement on transparent parts of the map"
msgstr "位移量乘以位移图的 alpha。GEGL 自带的 displace 总是这样，会让位移图的透明区域静默失去位移"

#: ops/displace/displace.c:119
msgid "Out of bounds"
msgstr "越界处理"

#: ops/displace/displace.c:121
msgid "How pixels pulled from outside the image are resolved. Wrap around keeps tiles seamless, repeat edge pixels avoids both seams and smears behind a small elongation"
msgstr "采到图像外时如何取值。环绕适合无缝贴图；重复边缘既不产生接缝，也不会在拉伸背后拖出长条"

#: ops/displace/displace.c:125
msgid "Resampling"
msgstr "重采样"

#: ops/displace/displace.c:127
msgid "Bilinear never overshoots; bicubic is sharper on smooth maps but rings on hard edges; nohalo and lohalo stay sharp without ringing"
msgstr "双线性不会过冲；双三次在平滑处更锐，但硬边会振铃；nohalo 与 lohalo 锐利且不振铃"

#: ops/displace/displace.c:417
msgid "Displacement map"
msgstr "位移图"

#: ops/displace/displace.c:418
msgid "Map that drives the displacement; without it the image passes through"
msgstr "驱动位移的图；不接则原样输出"

#: ops/displace/displace.c:423
#: ops/displace/displace.c:429
msgid "Displace"
msgstr "置换"

#: ops/displace/displace.c:424
msgid "Resamples the image through a displacement map: one RGBA map drives both axes, amounts in pixels or percent of the long edge, five edge policies and a sampler that does not ring by default."
msgstr "按位移图重采样图像：一张 RGBA 图同时驱动两轴，位移量可按像素或长边百分比，五种越界策略，默认用不振铃的采样器。"

#: ops/displace/displace.c:40
msgid "Pixels"
msgstr "像素"

#: ops/displace/displace.c:41
msgid "Percent of long edge"
msgstr "长边百分比"

#: ops/displace/displace.c:46
msgid "Vector (R = X, G = Y)"
msgstr "矢量（R = X，G = Y）"

#: ops/displace/displace.c:47
msgid "Single channel"
msgstr "单通道"

#: ops/displace/displace.c:61
msgid "Wrap around"
msgstr "环绕"

#: ops/displace/displace.c:62
msgid "Repeat edge pixels"
msgstr "重复边缘像素"

#: ops/displace/displace.c:63
msgid "Transparent"
msgstr "透明"

#: ops/displace/displace.c:64
msgid "Black"
msgstr "黑色"

#: ops/displace/displace.c:65
msgid "White"
msgstr "白色"

#: ops/displace/displace.c:70
msgid "Nearest"
msgstr "最近邻"

#: ops/displace/displace.c:71
msgid "Bilinear"
msgstr "双线性"

#: ops/displace/displace.c:72
msgid "Bicubic"
msgstr "双三次"

#: ops/displace/displace.c:73
msgid "Nohalo (no ringing)"
msgstr "Nohalo（不振铃）"

#: ops/displace/displace.c:74
msgid "Lohalo (no ringing, slow)"
msgstr "Lohalo（不振铃，较慢）"
#: ops/add-noise/add-noise.c:39
#: ops/unsharp-mask/unsharp-mask.c:45
msgid "Amount"
msgstr "数量"

#: ops/add-noise/add-noise.c:40
msgid "Noise strength in percent. 100% means a standard deviation of a quarter of the full range for Gaussian noise, or ±half the range for uniform noise."
msgstr "噪点强度，百分比。100% 表示高斯分布的标准差为量程的四分之一，或均匀分布幅度为正负半个量程。"

#: ops/add-noise/add-noise.c:46
msgid "Distribution"
msgstr "分布"

#: ops/add-noise/add-noise.c:48
msgid "Gaussian looks like film grain and sensor noise; uniform looks like digital dithering."
msgstr "高斯分布像胶片颗粒与传感器噪点；均匀分布像数字抖动。"

#: ops/add-noise/add-noise.c:51
msgid "Monochromatic"
msgstr "单色"

#: ops/add-noise/add-noise.c:52
msgid "Use one value for all three channels, giving grey grain instead of coloured speckle. Photoshop's Monochromatic checkbox."
msgstr "三个通道共用一个值，得到灰度颗粒而不是彩色斑点。对应 Photoshop 的「单色」勾选。"

#: ops/add-noise/add-noise.c:56
msgid "Seed"
msgstr "种子"

#: ops/add-noise/add-noise.c:57
msgid "Same seed and same image always give the same noise, so a look can be reproduced exactly."
msgstr "同一个种子、同一张图永远得到同一份噪点，效果可以精确复现。"

#: ops/add-noise/add-noise.c:177
msgid "Add Noise"
msgstr "添加杂色"

#: ops/add-noise/add-noise.c:178
msgid "Adds Gaussian or uniform noise, monochromatic or per channel. The seed makes the grain reproducible."
msgstr "添加高斯或均匀噪点，可单色或逐通道。种子让颗粒可以复现。"

#: ops/add-noise/add-noise.c:35
msgid "Gaussian"
msgstr "高斯"

#: ops/add-noise/add-noise.c:36
msgid "Uniform"
msgstr "均匀"

#: ops/color-lookup/color-lookup.c:39
#: ops/reduce-noise/reduce-noise.c:36
msgid "Strength"
msgstr "强度"

#: ops/dust-scratches/dust-scratches.c:36
msgid "Neighbourhood radius in pixels. 1 is a 3×3 window. Bigger values remove bigger specks and also soften more detail."
msgstr "邻域半径（像素）。1 即 3×3 窗口。值越大去掉的斑点越大，同时也会柔化更多细节。"

#: ops/dust-scratches/dust-scratches.c:41
#: ops/unsharp-mask/unsharp-mask.c:51
#: plugin/sky-replace/sky-replace.py:220
msgid "Threshold"
msgstr "阈值"

#: ops/dust-scratches/dust-scratches.c:42
msgid "Neighbours that differ from the centre pixel by more than this many levels (0–255) are ignored, which is what keeps real edges intact. Raise it to remove stronger dust, lower it to protect fine texture."
msgstr "与中心像素相差超过这个码数（0–255）的邻居不参与计算，真实边缘正是靠它保住的。调高可以去掉更明显的灰尘，调低则更保护细微纹理。"

#: ops/dust-scratches/dust-scratches.c:226
msgid "Dust & Scratches"
msgstr "蒙尘与划痕"

#: ops/dust-scratches/dust-scratches.c:227
msgid "Replaces a pixel with the median of the neighbours that are within the threshold, so isolated dust and scratches vanish while real edges — whose neighbours differ too much — stay untouched."
msgstr "用阈值内邻居的中值替换该像素，孤立的灰尘与划痕消失，而邻居差异过大的真实边缘保持不动。"

#: ops/reduce-noise/reduce-noise.c:37
msgid "How aggressively neighbours are averaged. Higher values smooth more and start to eat texture."
msgstr "邻域平均的强度。值越大抹得越狠，也开始吃掉纹理。"

#: ops/reduce-noise/reduce-noise.c:41
msgid "Preserve detail"
msgstr "保留细节"

#: ops/reduce-noise/reduce-noise.c:42
msgid "Shrinks the averaging threshold so fine texture survives. Photoshop's Preserve Details slider."
msgstr "收窄平均阈值，让细微纹理保留下来。对应 Photoshop 的「保留细节」。"

#: ops/reduce-noise/reduce-noise.c:47
msgid "Neighbourhood radius in pixels. 1 is a 3×3 window; larger radii handle coarser grain but cost quadratically more."
msgstr "邻域半径（像素）。1 即 3×3 窗口；半径越大能处理越粗的颗粒，代价按平方增长。"

#: ops/reduce-noise/reduce-noise.c:52
msgid "Per channel"
msgstr "每通道"

#: ops/reduce-noise/reduce-noise.c:53
msgid "Off: the three channels share one weight set, so colour speckle disappears without shifting hues. On: each channel is filtered on its own, which suits luminance noise only."
msgstr "关闭时三个通道共用一份权重，彩色噪点消失而色调不变；打开时每个通道各自过滤，适合只处理明度噪点。"

#: ops/reduce-noise/reduce-noise.c:215
msgid "Reduce Noise"
msgstr "减少杂色"

#: ops/reduce-noise/reduce-noise.c:216
msgid "Sigma filter: averages only neighbours close to the centre pixel, so flat areas are smoothed and edges are left alone. Colour speckle can be removed without shifting hues."
msgstr "Sigma 滤波：只平均与中心像素接近的邻居，平坦区被抹平、边缘保持原样。彩色噪点可以在不改变色调的前提下去掉。"

#: ops/unsharp-mask/unsharp-mask.c:38
msgid "Blur radius the sharpening is measured against. Small values sharpen fine texture, large values build local contrast (the so-called clarity look)."
msgstr "作为参照的模糊半径。值小锐化细微纹理，值大提升局部对比（所谓「清澈感」）。"

#: ops/unsharp-mask/unsharp-mask.c:46
msgid "How much of the difference is added back, in percent. Photoshop's Amount slider, 1–500%."
msgstr "差值加回去的比例，百分比。对应 Photoshop 的「数量」，1–500%。"

#: ops/unsharp-mask/unsharp-mask.c:52
msgid "Differences below this many levels (0–255) count as flat area and are left alone, so grain and sensor noise are not amplified. Photoshop's Threshold slider."
msgstr "差值小于这个码数（0–255）的判为平坦区，原样保留，避免放大颗粒与传感器噪点。对应 Photoshop 的「阈值」。"

#: ops/unsharp-mask/unsharp-mask.c:58
msgid "Halo suppression"
msgstr "光晕抑制"

#: ops/unsharp-mask/unsharp-mask.c:59
msgid "Clamp the sharpened value to the 3×3 neighbourhood of the original, in percent. At 100 the white and dark fringes along hard edges disappear; at 0 this is a plain unsharp mask."
msgstr "把锐化结果夹到原图 3×3 邻域内，百分比。100 时硬边两侧的白边与暗边完全消失；0 就是普通的 USM 锐化。"

#: ops/unsharp-mask/unsharp-mask.c:388
msgid "Unsharp Mask"
msgstr "USM 锐化"

#: ops/unsharp-mask/unsharp-mask.c:389
msgid "Sharpens against a blurred copy with the amount, radius and threshold of Photoshop's Unsharp Mask, plus a halo suppression stage that clamps the result to the 3×3 neighbourhood so hard edges do not grow white fringes."
msgstr "对比模糊副本做锐化，数量、半径、阈值与 Photoshop 的 USM 一致；另加一级光晕抑制，把结果夹到 3×3 邻域，硬边不会长出白边。"


# ---- plugin/ai-inpaint（2026-11-20） ----
#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint"
msgstr "AI 局部重绘"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint: repaint the selection with a local ComfyUI / Stable Diffusion and paste the result back as a masked layer"
msgstr "AI 局部重绘：用本机 ComfyUI / Stable Diffusion 重画选区，再贴回成带蒙版的新图层"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Selection + prompt -> ComfyUI inpaint -> new layer with a feathered selection mask. Requires a running ComfyUI (default http://127.0.0.1:8188)."
msgstr "选区 + 提示词 → ComfyUI 重绘 → 带羽化蒙版的新图层。需要 ComfyUI 在跑（默认 http://127.0.0.1:8188）。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Prompt"
msgstr "提示词"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "What should appear in the selection (English works best)"
msgstr "选区内想出现什么（英文效果最好）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Negative prompt"
msgstr "反向提示词"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "What to keep out of the result"
msgstr "不想出现在结果里的东西"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "ComfyUI address"
msgstr "ComfyUI 地址"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Empty = $LB_COMFY_URL, else http://127.0.0.1:8188"
msgstr "留空＝用 $LB_COMFY_URL，否则 http://127.0.0.1:8188"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Checkpoint"
msgstr "底模"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Model file name; empty picks the first one ComfyUI offers"
msgstr "底模文件名；留空用 ComfyUI 里的第一个（会跳过 inpaint 专用模型）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Steps"
msgstr "步数"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Sampling steps (25 is a good default)"
msgstr "采样步数（25 是不错的默认值）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "CFG"
msgstr "CFG"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Prompt guidance strength"
msgstr "提示词强度"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Seed"
msgstr "随机种子"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Random seed; -1 picks a new one each run"
msgstr "随机种子；-1 表示每次换一个"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Denoise"
msgstr "重绘幅度"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "1.0 fully repaints the masked area, lower keeps more of it"
msgstr "1.0 完全重绘蒙版区，调小则保留更多原像素"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Grow mask"
msgstr "蒙版外扩"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Pixels to expand the selection before sending (softens seams)"
msgstr "送出前把选区外扩多少像素（接缝更柔和）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Model mask grow"
msgstr "模型蒙版外扩"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Extra pixels the model may touch (8 px = 1 latent cell; bigger = fewer seams, more drift)"
msgstr "模型可触及的额外像素（8 像素＝1 个 latent 格；越大接缝越少、越容易跑偏）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Timeout (s)"
msgstr "超时（秒）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "How long to wait for ComfyUI before giving up"
msgstr "等 ComfyUI 多久算超时"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Keep mask channel"
msgstr "保留蒙版通道"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Keep the 'AI Mask' channel so the result can be re-masked later"
msgstr "保留「AI Mask」通道，之后还能重新取蒙版"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "No image or no layer selected"
msgstr "没有图像或没有选中图层"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "No selection"
msgstr "当前没有选区"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Make a selection first: frame what you want repainted (a rough one is fine — grow/feather cleans up the edges)."
msgstr "先建一个选区再跑这个插件：框住想重画的地方（粗糙没关系，grow / feather 会收拾边缘）。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "The prompt is empty: describe what should appear (English works best)"
msgstr "提示词是空的：写一句想画成什么（英文效果最好）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Failed to read layer pixels: expected %d bytes, got %d"
msgstr "读取图层像素失败：期望 %d 字节，收到 %d"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Failed to read the selection buffer: expected %d bytes, got %d"
msgstr "读取选区缓冲失败：期望 %d 字节，收到 %d"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Could not read the inpainting result (%s)"
msgstr "读不回重绘结果（%s）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "plugin/_shared/ai_client.py is missing: install the _shared folder next to the plug-in"
msgstr "缺少 plugin/_shared/ai_client.py：安装时要把 _shared 一起放进 GIMP 插件目录"

# ---- plugin/ai-inpaint：工作分辨率（2026-11-20） ----
#: plugin/ai-inpaint/ai-inpaint.py
msgid "Working scale"
msgstr "工作尺寸缩放"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "0 = fit the model's native size (SD1.5 512, SDXL 1024); 1.0 = send the crop unchanged"
msgstr "0＝自动贴合底模的原生尺寸（SD1.5 为 512、SDXL 为 1024）；1.0＝按裁切框原样送出"

# ---- plugin/ai-inpaint：提示词改为必填 + 拦中文（2026-11-20） ----
#: plugin/ai-inpaint/ai-inpaint.py
msgid "Describe the RESULT, not the thing to delete: to remove a bottle write "empty wooden table, wood grain" rather than "remove the bottle". SD models only read English."
msgstr "描述**结果**，不是要删掉的东西：去掉一个瓶子要写「empty wooden table, wood grain」，而不是「remove the bottle」。SD 模型只认英文。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Feather radius of the layer mask used when pasting back"
msgstr "贴回时图层蒙版的羽化半径"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Prompt — what the selection should become (English, required)"
msgstr "提示词 —— 选区内要变成什么（英文，必填）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "The prompt contains Chinese/Japanese/Korean characters. SD1.5 and SDXL can only read English — anything else is treated as random noise, which is why the result looked unrelated to your picture. Write it in English, e.g. "empty wooden table, wood grain, soft daylight", and put what you want removed into the negative prompt."
msgstr "提示词里有中文/日文/韩文字符。SD1.5 和 SDXL 只认英文，其他文字会被当成随机噪声——这就是结果跟你的图对不上的原因。请改成英文，例如「empty wooden table, wood grain, soft daylight」；想删掉的东西写进反向提示词。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "The prompt is empty — this box is what the AI paints, so it must say what should appear. Describe the RESULT, not the thing you want gone: to erase a bottle, write "empty wooden table, wood grain" instead of "remove the bottle"."
msgstr "提示词是空的——这一栏就是 AI 要画的内容，必须写清楚。描述**结果**，不要描述要删的东西：去掉一个瓶子写「empty wooden table, wood grain」，而不是「remove the bottle」。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "What must not appear — put the thing you are deleting here"
msgstr "不该出现的东西——想删掉的对象写在这里"


# ---- plugin/convert：路径转位图 + 补齐转换文案（2026-11-22） ----
#: plugin/convert/convert.py
msgid "Filling the path failed; the image may be in a mode that cannot take a new RGBA layer."
msgstr "填充路径失败；图像可能处于无法新建 RGBA 图层的模式。"

#: plugin/convert/convert.py
msgid "No image"
msgstr "没有图像"

#: plugin/convert/convert.py
msgid "Rasterise the selected path into a layer mask on every selected layer."
msgstr "把选中路径栅格化为每个选中图层的图层蒙版。"

#: plugin/convert/convert.py
msgid "Rasterise the selected path into a new channel."
msgstr "把选中路径栅格化为新通道。"

#: plugin/convert/convert.py
msgid "Save the current selection as a new channel."
msgstr "把当前选区存成新通道。"

#: plugin/convert/convert.py
msgid "Take the channel selected in the Channels dock and turn it into the pixel selection."
msgstr "把通道面板里选中的通道转成像素选区。"

#: plugin/convert/convert.py
msgid "This path encloses no area to fill; check that it has at least one stroke."
msgstr "这条路径没有可填充的面积；确认它至少有一个 stroke。"

#: plugin/convert/convert.py
msgid "Trace the current selection into a new path (the native Select > To Path geometry, with a readable name)."
msgstr "把当前选区描成新路径（几何与原生「选择 → 路径」一致，只是给了个看得懂的名字）。"

#: plugin/convert/convert.py
msgid "Trace the selected channel's 50% contour into a new path."
msgstr "把选中通道的 50% 等值线描成新路径。"

#: plugin/convert/convert.py
msgid "Trace the selected layer's mask into a new path."
msgstr "把选中图层的蒙版描成新路径。"

#: plugin/convert/convert.py
msgid "Turn the selected layer's layer mask into a new channel."
msgstr "把选中图层的蒙版转成新通道。"

#: plugin/convert/convert.py
msgid "Turn the selected layer's layer mask into the pixel selection."
msgstr "把选中图层的蒙版转成像素选区。"

#: plugin/convert/convert.py
msgid "Turn the selected path into the pixel selection."
msgstr "把选中路径转成像素选区。"

#: plugin/convert/convert.py
msgid "Use the current selection as a layer mask on every selected layer."
msgstr "把当前选区用作每个选中图层的图层蒙版。"

#: plugin/convert/convert.py
msgid "Use the selected channel's grey levels as a layer mask on every selected layer."
msgstr "把选中通道的灰度用作每个选中图层的图层蒙版。"

#: plugin/convert/convert.py
msgid "Path to Bitmap"
msgstr "路径转位图"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Some words in the prompt are not in the built-in Chinese dictionary: %s. SD models only read English — rephrase with common words, or write that part in English."
msgstr "提示词里这些词不在内置中文词表里：%s。SD 只认英文——换个常见说法，或者把这一段直接写成英文。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "The prompt is empty — this box is what the AI paints, so it must say what should appear. Describe the RESULT, not the thing you want gone: to erase a bottle, write \"empty wooden table, wood grain\" instead of \"remove the bottle\"."
msgstr "提示词是空的——这个框里写的才是 AI 要画的东西，必须说明这里应该出现什么。写「结果」，不要写「要删掉的东西」：想把瓶子去掉，就写 \"empty wooden table, wood grain\"，而不是 \"remove the bottle\"。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "The prompt contains Chinese/Japanese/Korean characters. SD1.5 and SDXL can only read English — anything else is treated as random noise, which is why the result looked unrelated to your picture. Write it in English, e.g. \"empty wooden table, wood grain, soft daylight\", and put what you want removed into the negative prompt."
msgstr "提示词里有中文/日文/韩文字符。SD1.5 和 SDXL 只认英文——其他文字会被当成随机噪声，这就是结果跟你图片完全不搭的原因。请用英文写，例如 \"empty wooden table, wood grain, soft daylight\"，要删掉的东西写进负面提示词。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "What to paint"
msgstr "画什么"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Pick a subject and the prompt starts from it — the prompt box then only needs the details (colour, pose, surroundings)"
msgstr "选一个主体，提示词从它开始写——下面的提示词框只补细节（颜色、姿态、环境）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "What to paint (none / cat / dog / person / flower / tree / coffee / food / car)"
msgstr "画什么（none / cat / dog / person / flower / tree / coffee / food / car）"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Leave empty for none"
msgstr "留空＝不预设"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Prompt — what the selection should become"
msgstr "提示词——选区这里应该变成什么"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Describe the RESULT. Chinese is fine for common words (the plug-in translates them); SD itself only reads English. To remove a bottle, write \"empty wooden table, wood grain\" rather than \"remove the bottle\"."
msgstr "描述「结果」。常用词可以直接写中文（插件会翻成英文），SD 本身只认英文。想把瓶子去掉，写 \"empty wooden table, wood grain\"，而不是 \"remove the bottle\"。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint (Advanced)…"
msgstr "AI 局部重绘（高级）…"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint (Advanced): every sampling and blending knob"
msgstr "AI 局部重绘（高级）：所有采样与融合参数"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Selection + prompt -> ComfyUI inpaint -> new layer with a feathered selection mask. Exposes steps/CFG/seed/denoise/mask grow/feather/working scale."
msgstr "选区 + 提示词 → ComfyUI 重绘 → 带羽化选区蒙版的新图层。可调 steps / CFG / seed / denoise / 蒙版扩展 / 羽化 / 工作倍率。"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint…"
msgstr "AI 局部重绘…"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "AI Inpaint: frame the area, say what should be there, done"
msgstr "AI 局部重绘：框一块地方，说清这里该有什么，完事"

#: plugin/ai-inpaint/ai-inpaint.py
msgid "Selection + prompt -> ComfyUI inpaint -> new layer. Only asks what to paint; the sampling settings use good defaults. Use \"AI Inpaint (Advanced)\" to change them."
msgstr "选区 + 提示词 → ComfyUI 重绘 → 新图层。只问你要画什么，采样参数走默认值；要改就去「AI 局部重绘（高级）」。"

#: plugin/_shared/prompt_tools.py
msgid "None (write my own)"
msgstr "不预设（自己写）"

#: plugin/_shared/prompt_tools.py
