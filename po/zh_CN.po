msgstr "蒙版 → 通道「%s」"

#: plugin/convert/convert.py:534
msgid "Selection to the mask of %d layer(s)"
msgstr "选区 → %d 个图层的蒙版"

#: plugin/convert/convert.py:537
msgid "Mask \"%s\" to selection"
msgstr "蒙版「%s」→ 选区"

#: plugin/convert/convert.py:540
msgid "Path \"%s\" to selection"
msgstr "路径「%s」→ 选区"

#: plugin/convert/convert.py:543
